# Copie este arquivo para ".env" no servidor e preencha. Nunca envie o ".env" para o GitHub.

NODE_ENV=production
PORT=3000

# Atrás de Render, Railway, Fly, Nginx ou Cloudflare: 1. Rodando direto na internet sem proxy: 0.
TRUST_PROXY=1

# Primeiro acesso ao painel. Só vale na primeira vez que o servidor inicia com o banco vazio.
# Se deixar a senha em branco ou com menos de 10 caracteres, o servidor gera uma e mostra nos logs.
ADMIN_USER=admin
ADMIN_PASSWORD=

# E-mail mostrado na seção de contato (também dá para mudar no painel, em Configurações).
CONTACT_EMAIL=

# Pasta do banco de dados, das fotos enviadas e dos backups. Em hospedagem com disco persistente,
# aponte para o disco (ex.: /var/data).
DATA_DIR=./data
